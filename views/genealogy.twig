{% extends 'layout.twig' %}

{% block styles %}
    <link rel="stylesheet" href="/public/css/genealogy.css">
{% endblock %}

{% block content %}
    <!-- 搜索栏 -->
    <div class="search-bar">
        <input type="text" id="searchInput" class="search-input" placeholder="请输入姓名或ID搜索..." />
        <button class="search-btn" onclick="searchNode()">搜索</button>
        <button class="clear-btn" onclick="clearSearch()">清空</button>
        <button class="manage-btn" onclick="openManagePanel()">管理</button>
        <button class="logout-btn" id="logoutBtn" onclick="logoutAdmin()">退出</button>
    </div>

    <!-- 管理员登录弹窗 -->
    <div class="login-overlay" id="loginOverlay" onclick="closeLoginPanel()">
        <div class="login-panel" onclick="event.stopPropagation()">
            <h3>管理员登录</h3>
            <div class="field">
                <label for="loginUsername">账号</label>
                <input type="text" id="loginUsername" autocomplete="username" />
            </div>
            <div class="field">
                <label for="loginPassword">密码</label>
                <input type="password" id="loginPassword" autocomplete="current-password" />
            </div>
            <div class="login-actions">
                <button type="button" class="login-submit" onclick="submitLogin()">登录</button>
                <button type="button" class="login-cancel" onclick="closeLoginPanel()">取消</button>
            </div>
        </div>
    </div>

    <div id="tree-container">
        <div class="loading" id="loading">数据加载中...</div>
        <svg id="family-tree"></svg>
    </div>

    <!-- 多条关系提示容器 -->
    <div id="tooltipContainer"></div>

    <!-- 管理居中弹窗 -->
    <div class="manage-overlay" id="manageOverlay">
        <div class="manage-panel" id="managePanel" onclick="event.stopPropagation()">
            <div class="manage-header">
                <span>族谱成员管理</span>
                <button class="manage-close" type="button" onclick="closeManagePanel()">&times;</button>
            </div>
            <div class="manage-toolbar">
                <input type="text" id="manageFilter" placeholder="筛选姓名或 ID..." oninput="renderManageTable()" />
                <button type="button" onclick="openManageForm('create')">新增</button>
            </div>
            <div class="manage-table-wrap">
                <table class="manage-table">
                    <thead>
                        <tr>
                            <th style="width: 70px">ID</th>
                            <th style="width: 160px">姓名</th>
                            <th style="width: 70px">父辈</th>
                            <th style="width: 70px">性别</th>
                            <th>简介</th>
                            <th style="width: 120px">操作</th>
                        </tr>
                    </thead>
                    <tbody id="manageTableBody"></tbody>
                </table>
            </div>
            <div class="manage-form" id="manageForm" style="display: none">
                <h4 id="manageFormTitle">新增成员</h4>
                <input type="hidden" id="formId" />
                <div class="field">
                    <label for="formName">姓名 *</label>
                    <input type="text" id="formName" required />
                </div>
                <div class="field">
                    <label for="formParent">父辈</label>
                    <select id="formParent"></select>
                </div>
                <div class="field">
                    <label for="formSex">性别</label>
                    <input type="text" id="formSex" placeholder="男 / 女" />
                </div>
                <div class="field">
                    <label for="formDesc">简介</label>
                    <textarea id="formDesc"></textarea>
                </div>
                <div class="manage-form-btns">
                    <button type="button" class="btn-save" onclick="saveManageForm()">保存</button>
                    <button type="button" class="btn-cancel-form" onclick="closeManageForm()">取消</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 悬浮desc提示框 -->
    <div class="desc-tooltip" id="descTooltip"></div>
{% endblock %}
{% block script %}
    <script src="https://cdn.jsdmirror.com/npm/d3@7.9.0/dist/d3.min.js"></script>
    <script src="/public/js/genealogy.js"></script>
{% endblock %}
